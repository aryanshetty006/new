# Build stage
FROM debian:stable-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    TERM=xterm-256color \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# Install build dependencies and tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential cmake git wget curl \
      libjson-c-dev libwebsockets-dev libuv1-dev \
      python3-pip python3-setuptools \
      locales && \
    echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen && \
    locale-gen && \
    rm -rf /var/lib/apt/lists/*

# Build ttyd
RUN git clone --depth 1 https://github.com/tsl0922/ttyd.git /tmp/ttyd && \
    cd /tmp/ttyd && \
    mkdir build && cd build && \
    cmake .. && \
    make && \
    make install && \
    rm -rf /tmp/ttyd

# Install Python packages
RUN pip3 install --break-system-packages --no-cache-dir \
      requests beautifulsoup4 paramiko scapy python-nmap dnspython colorama \
      pwntools volatility3 binwalk

# Download GDB tools
RUN mkdir -p /opt && \
    git clone --depth 1 https://github.com/longld/peda.git /opt/peda && \
    wget -q -O /opt/gef.py https://github.com/hugsy/gef/raw/main/gef.py

# Runtime stage
FROM alpine:latest

ENV TERM=xterm-256color \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# Install runtime dependencies and security tools
RUN apk add --no-cache \
      bash sudo curl wget nano git file less coreutils \
      nmap nmap-scripts netcat-openbsd tcpdump \
      iputils-ping traceroute bind-tools \
      python3 py3-pip py3-setuptools \
      strace binutils gdb \
      vim lsof libcap unzip openjdk17-jre \
      iproute2 procps net-tools \
      libstdc++ libgcc && \
    rm -rf /var/cache/apk/*

# Copy built binaries and tools from builder
COPY --from=builder /usr/local/bin/ttyd /usr/local/bin/ttyd
COPY --from=builder /opt/peda /opt/peda
COPY --from=builder /opt/gef.py /opt/gef.py

# Install Python packages in Alpine
# Note: Some packages may need to be reinstalled for Alpine compatibility
RUN pip3 install --break-system-packages --no-cache-dir \
      requests beautifulsoup4 paramiko scapy python-nmap dnspython colorama || true

# User setup
RUN adduser -D -s /bin/bash kali && \
    echo 'kali:kali' | chpasswd && \
    adduser kali wheel && \
    echo '%wheel ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers && \
    touch /home/kali/.hushlogin && \
    mkdir -p /home/kali/.local/bin

# Setup GDB
RUN echo "source /opt/gef.py" > /home/kali/.gdbinit && \
    chown -R kali:kali /home/kali /opt/peda /opt/gef.py

# Copy entrypoint script
COPY entry_point.sh /usr/local/bin/entry_point.sh
RUN chmod +x /usr/local/bin/entry_point.sh

# Set capabilities (Alpine uses different paths)
RUN setcap cap_net_raw+ep /usr/bin/ping 2>/dev/null || true && \
    setcap cap_net_raw,cap_net_admin,cap_net_bind_service+eip /usr/bin/nmap 2>/dev/null || true && \
    setcap cap_net_raw,cap_net_admin+eip /usr/sbin/tcpdump 2>/dev/null || true

WORKDIR /home/kali
USER kali

CMD ["/bin/bash"]
